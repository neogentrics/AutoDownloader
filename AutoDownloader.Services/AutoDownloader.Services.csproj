<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only AngleSharp.Dom and AngleSharp.Html.Parser are used, both of which live in
         the base package. The Io/Js/Scripting/Wrappers/Xml/XPath satellites were unused;
         AngleSharp.Scripting.JavaScript in particular is a .NET Framework package. -->
    <PackageReference Include="AngleSharp" Version="1.8.2" />
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageReference Include="TMDbLib" Version="2.3.0" />
    <!-- Local rebuild targeting netstandard2.1; see vendor-packages/README.md -->
    <PackageReference Include="TvDbSharper" Version="4.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoDownloader.Core\AutoDownloader.Core.csproj" />
  </ItemGroup>

</Project>
