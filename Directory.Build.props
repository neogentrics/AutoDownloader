<Project>

  <!-- One place to set the version. Previously the title bar, the welcome text and the CLI
       each carried their own hardcoded string and disagreed with each other. -->
  <PropertyGroup>
    <!-- 2.1.2: episodes are numbered by the title the link carries rather than by position,
         so a season the source is missing an episode from no longer shifts every title after
         it. Includes the two corrections that needed - a title the databases spell
         differently takes the one number free between its neighbours, and a listing half
         made of alternate cuts is still trusted - plus a source-is-short check that reports
         season by season, and a season tab that carries another season's episodes no longer
         keeps them. -->
    <VersionPrefix>2.1.2</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <Product>AutoDownloader</Product>
    <Company>Neo Gentrics</Company>
  </PropertyGroup>

</Project>
