<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Scoped to this repository so a clean clone (and CI) restores without
       depending on machine-level sources. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="vendor-packages" value="vendor-packages" />
  </packageSources>
</configuration>
