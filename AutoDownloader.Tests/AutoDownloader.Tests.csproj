<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Pure-logic tests only: no network, no browser, no yt-dlp. These are the rules that
       decide which show gets looked up and what each file is called, so a silent regression
       here is expensive. Keeping them dependency-free means CI can run them in seconds. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="MSTest" Version="3.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoDownloader.Core\AutoDownloader.Core.csproj" />
    <ProjectReference Include="..\AutoDownloader.Services\AutoDownloader.Services.csproj" />
    <ProjectReference Include="..\AutoDownloader.Cli\AutoDownloader.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
