<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- The WindowsAPICodePack folder picker was replaced with the built-in
       Microsoft.Win32.OpenFolderDialog (shipped in .NET 8+), which removes three
       packages including an unofficial upload and a .NET Framework dependency.
       TMDbLib was referenced here but never used; metadata lives in .Services. -->

  <ItemGroup>
    <ProjectReference Include="..\AutoDownloader.Core\AutoDownloader.Core.csproj" />
    <ProjectReference Include="..\AutoDownloader.Services\AutoDownloader.Services.csproj" />
  </ItemGroup>

</Project>
