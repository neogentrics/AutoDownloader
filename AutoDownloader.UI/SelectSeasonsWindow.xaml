<Window x:Class="AutoDownloader.UI.SelectSeasonsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Which seasons?" Height="470" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="{DynamicResource Surface}"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="ChoiceButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="18">

        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="HeadingTextBlock" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="SemiBold"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="SubheadingTextBlock" Foreground="{DynamicResource TextMuted}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                <Button Content="Select all" Width="90" Background="{DynamicResource SurfaceInput}"
                        Style="{StaticResource ChoiceButtonStyle}" Click="SelectAll_Click"/>
                <Button Content="Select none" Width="100" Background="{DynamicResource SurfaceInput}"
                        Style="{StaticResource ChoiceButtonStyle}" Click="SelectNone_Click"/>
                <Button x:Name="CurrentOnlyButton" Content="Only this one" Width="120" Background="{DynamicResource SurfaceInput}"
                        Style="{StaticResource ChoiceButtonStyle}" Click="CurrentOnly_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock x:Name="SelectionSummaryTextBlock" Foreground="{DynamicResource TextMuted}" FontSize="12"
                       Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DownloadButton" Content="Download" Width="120"
                        Style="{StaticResource ChoiceButtonStyle}" Background="#FF28A745"
                        Click="Download_Click"/>
                <Button Content="Cancel" Width="80"
                        Style="{StaticResource ChoiceButtonStyle}" Background="#FF6C757D"
                        Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>

        <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="5" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SeasonsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Label}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Foreground="{DynamicResource TextPrimary}"
                                      FontSize="13"
                                      Margin="8,6"
                                      Checked="SeasonCheckBox_Changed"
                                      Unchecked="SeasonCheckBox_Changed"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
