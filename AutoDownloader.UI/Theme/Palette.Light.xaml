<!--
    Light - for a bright room.

    Palette only. The control styles live in Controls.xaml and reach these by
    DynamicResource, so swapping this one file changes the whole application at runtime.
    Every palette must define the same keys or the swap leaves holes.

    The system brush overrides are the important half: popups, menus and tooltips are drawn
    by Windows' default templates using those keys, so without them a dropdown opens as a
    sheet of the system colour regardless of what the styles say.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Surface"        Color="#FFF5F5F5"/>
    <SolidColorBrush x:Key="SurfaceRaised"  Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceInput"   Color="#FFECECEC"/>
    <SolidColorBrush x:Key="SurfaceSunken"  Color="#FFE4E4E4"/>
    <SolidColorBrush x:Key="TextPrimary"    Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="TextMuted"      Color="#FF5A5A5A"/>
    <SolidColorBrush x:Key="TextDisabled"   Color="#FF9A9A9A"/>
    <SolidColorBrush x:Key="Accent"         Color="#FF0067B8"/>
    <SolidColorBrush x:Key="AccentText"     Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="BorderSubtle"   Color="#FFC4C4C4"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"        Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}"    Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"       Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}"   Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}"  Color="#FFECECEC"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}"   Color="#FFC4C4C4"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}"          Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}"      Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}"       Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}"          Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}"      Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}"      Color="#FF9A9A9A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"     Color="#FF0067B8"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                     Color="#FFECECEC"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                     Color="#FF1A1A1A"/>

</ResourceDictionary>
