<Window x:Class="AutoDownloader.UI.SupportedSitesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supported Sites" Height="560" Width="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="{DynamicResource Surface}"
        Loaded="Window_Loaded">

    <DockPanel Margin="15">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="HeadingTextBlock" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="SemiBold"
                       Text="Loading the list from yt-dlp..."/>
            <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="These are read from the installed yt-dlp, so the list is always what it actually supports rather than something written down here. A page that embeds a player from one of these also works, even when the page itself is not listed."/>
        </StackPanel>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBox x:Name="SearchTextBox"
                     Height="30" Padding="8,5"
                     Background="{DynamicResource SurfaceInput}" Foreground="White"
                     BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchTextBox_TextChanged"/>
            <TextBlock x:Name="SearchHintTextBlock" Text="Search, e.g. bbc, vimeo, archive..."
                       Foreground="#FF888888" Margin="10,0,0,0"
                       VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="CountTextBlock" Foreground="#FF888888" VerticalAlignment="Center"
                       Margin="0,0,15,0" FontSize="12"/>
            <Button Content="Close" Click="CloseButton_Click"
                    Background="#FF6C757D" Foreground="White" BorderThickness="0"
                    Height="30" Width="80" FontWeight="SemiBold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <ListBox x:Name="SitesListBox"
                 Background="{DynamicResource SurfaceRaised}" Foreground="White"
                 BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                 FontFamily="Consolas" FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

    </DockPanel>
</Window>
