<Window x:Class="AutoDownloader.UI.SelectSeriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Which show did you mean?" Height="440" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="#FF1E1E1E"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF0099FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="15">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="HeadingTextBlock" Foreground="White" FontSize="15" FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
            <TextBlock Foreground="#FFB0B0B0" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="More than one show goes by this name, usually an original and a later reboot. The year tells them apart. Episode names come from whichever you pick, so choosing the wrong one produces plausible but incorrect filenames."/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ChooseButton" Content="Use This Show"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="ChooseButton_Click"
                    Background="#FF28A745" Height="32" Width="150"/>
            <Button Content="Cancel"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="CancelButton_Click"
                    Background="#FF6C757D" Height="32" Width="80"/>
        </StackPanel>

        <ListBox x:Name="CandidatesListBox"
                 Background="#FF2D2D2D"
                 Foreground="White"
                 BorderBrush="#FF555555"
                 BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="CandidatesListBox_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Display}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="{Binding Source}" Foreground="#FF8A8A8A" FontSize="11"
                                       VerticalAlignment="Center" Margin="10,2,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Overview}" Foreground="#FFBBBBBB" FontSize="11"
                                   TextWrapping="Wrap" MaxHeight="34" Margin="0,3,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Window>
