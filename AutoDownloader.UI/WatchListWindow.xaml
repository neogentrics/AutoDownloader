<Window x:Class="AutoDownloader.UI.WatchListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Watch List" Height="600" Width="760"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="#FF1E1E1E">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF0099FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#FF3A3A3A"/>
                                <Setter Property="Foreground" Value="#FF777777"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="15">

        <TextBlock DockPanel.Dock="Top" Foreground="#FFB0B0B0" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Series checked for new episodes. Already-downloaded episodes are skipped, so a repeat check costs a metadata lookup rather than a re-download. The same list is used by 'autodl --watch-run', which is what you would put on a schedule."/>

        <!-- Add a series -->
        <Border DockPanel.Dock="Top" Background="#FF252525" CornerRadius="5" Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UrlTextBox" Grid.Row="0" Grid.Column="0" Height="30" Margin="0,0,8,6"
                         ToolTip="The series or playlist URL to watch."/>
                <Button Grid.Row="0" Grid.Column="1" Content="Add" Width="90" Height="30"
                        Style="{StaticResource ActionButtonStyle}" Background="#FF28A745"
                        Click="AddButton_Click"/>

                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Season:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="SeasonTextBox" Width="55" Height="26" Margin="0,0,14,0"
                             ToolTip="Leave blank to use whatever the URL implies."/>
                    <TextBlock Text="Show name:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="ShowNameTextBox" Width="220" Height="26"
                             ToolTip="Only needed when the URL contains no usable name, such as a playlist."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Actions -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="CheckNowButton" Content="Check Now" Width="110" Height="32"
                    Style="{StaticResource ActionButtonStyle}" Click="CheckNowButton_Click"/>
            <Button x:Name="ToggleButton" Content="Enable/Disable" Width="120" Height="32"
                    Style="{StaticResource ActionButtonStyle}" Background="#FF4A4A4A"
                    Click="ToggleButton_Click"/>
            <Button x:Name="RemoveButton" Content="Remove" Width="90" Height="32"
                    Style="{StaticResource ActionButtonStyle}" Background="#FFA02020"
                    Click="RemoveButton_Click"/>
            <TextBlock x:Name="StatusTextBlock" Foreground="#FF888888" VerticalAlignment="Center"
                       Margin="10,0,0,0" FontSize="12" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <ListBox x:Name="EntriesListBox"
                 Background="#FF2D2D2D" Foreground="White"
                 BorderBrush="#FF555555" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Display}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Url}" Foreground="#FF9A9A9A" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        <TextBlock Foreground="#FFBBBBBB" FontSize="11" Margin="0,3,0,0">
                            <Run Text="Season "/><Run Text="{Binding Season, TargetNullValue=auto, Mode=OneWay}"/>
                            <Run Text="  ·  "/><Run Text="{Binding LastEpisodeCount, Mode=OneWay}"/><Run Text=" episode(s)"/>
                        </TextBlock>
                        <TextBlock Text="{Binding LastResult}" Foreground="#FF7FB37F" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Window>
